                                diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                              <joint name="robotiq_right_spring_link_joint" class="robotiq_spring_link"/>
                              <geom class="robotiq_visual" mesh="robotiq_spring_link" material="robotiq_black"/>
