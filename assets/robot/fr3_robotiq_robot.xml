    <mesh class="robotiq" name="robotiq_follower" file="meshes/robotiq/follower.stl"/>
    <mesh class="robotiq" name="robotiq_pad" file="meshes/robotiq/pad.stl"/>
    <mesh class="robotiq" name="robotiq_silicone_pad" file="meshes/robotiq/silicone_pad.stl"/>
    <mesh class="robotiq" name="robotiq_spring_link" file="meshes/robotiq/spring_link.stl"/>
  </asset>

  <worldbody>
