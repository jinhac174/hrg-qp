<mujoco model="fr3_robotiq">
  <!-- Franka Research 3 arm + Robotiq 2F-85 gripper (the DROID setup),
       torque-actuated.

       Arm: mujoco_menagerie/franka_fr3 (Apache-2.0), derived from
       franka_description. Gripper: mujoco_menagerie/robotiq_2f85
       (BSD-2-Clause), derived from Robotiq's public URDF.

       Changes vs menagerie:
         * Arm position servos replaced by torque motors. SimFrankaFR3 computes
           tau = kp*(q_des-q) + kd*(qd_des-qd) + tau_ff and writes ctrl[].
         * Gripper mounted on the flange (link7 + 0.107 m) in body fr3_gripper,
           not turned (0 deg about z: the DROID mount, checked in Viser against the real
           robot), so the closing axis is
           fr3_gripper's y and the approach axis its z. CHECK on your rig: if
           your gripper is mounted at another angle, change fr3_gripper's quat
           here AND in urdf/fr3_robotiq*.urdf (tests/unit/test_models.py
           checks that the two agree).
         * Gripper body / joint / geom names prefixed "robotiq_"; pads carry
           sites at their inner faces so the sim can measure the opening width.
         * Pad friction mu = 0.8, torsional gamma = 8 mm (condim 4), the values
           utils/grasping/parallel_jaw.py uses to predict grip forces.

       Joint ranges are the FR3 datasheet limits (menagerie values). Gravity
       compensation is NOT in this file: the platform sets body_gravcomp at
       load time to mimic the FR3 firmware, which compensates gravity
       internally (with the gripper load you enter in Desk). -->
  <compiler angle="radian" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="fr3">
      <!-- Overwritten in joints 5, 6, and 7. -->
      <joint damping="0.21" armature="0.195" frictionloss="1.137"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
    <default class="robotiq">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>
      <joint axis="1 0 0"/>
      <default class="robotiq_driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_follower">
        <joint range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065" solimplimit="0.95 0.99 0.001"
          solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="robotiq_coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="robotiq_collision">
        <geom type="mesh" group="3"/>
        <!-- Finger pads: mu = 0.8, gamma = 8 mm (see header). -->
        <default class="robotiq_pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375"
            friction="0.8 0.008 0.0001" condim="4" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"
            rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="robotiq_pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375"
            friction="0.8 0.008 0.0001" condim="4" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"
            rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
