  <contact>
    <exclude body1="fr3_link0" body2="fr3_link1"/>
    <exclude body1="fr3_link7" body2="robotiq_base_mount"/>
    <exclude body1="robotiq_base" body2="robotiq_left_driver"/>
    <exclude body1="robotiq_base" body2="robotiq_right_driver"/>
    <exclude body1="robotiq_base" body2="robotiq_left_spring_link"/>
    <exclude body1="robotiq_base" body2="robotiq_right_spring_link"/>
    <exclude body1="robotiq_right_coupler" body2="robotiq_right_follower"/>
    <exclude body1="robotiq_left_coupler" body2="robotiq_left_follower"/>
  </contact>

  <!-- Splits the actuator force evenly over both driver joints (menagerie). -->
  <tendon>
    <fixed name="robotiq_split">
      <joint joint="robotiq_right_driver_joint" coef="0.5"/>
      <joint joint="robotiq_left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <!-- Close the two 4-bar linkages and couple the two fingers. -->
  <equality>
    <connect anchor="0 0 0" body1="robotiq_right_follower" body2="robotiq_right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="robotiq_left_follower" body2="robotiq_left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="robotiq_right_driver_joint" joint2="robotiq_left_driver_joint" polycoef="0 1 0 0 0"
      solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!-- Torque actuators. ctrlrange = FR3 joint torque limits (Nm). -->
  <actuator>
    <motor joint="fr3_joint1" name="motor_fr3_joint1" ctrlrange="-87 87"/>
    <motor joint="fr3_joint2" name="motor_fr3_joint2" ctrlrange="-87 87"/>
    <motor joint="fr3_joint3" name="motor_fr3_joint3" ctrlrange="-87 87"/>
    <motor joint="fr3_joint4" name="motor_fr3_joint4" ctrlrange="-87 87"/>
    <motor joint="fr3_joint5" name="motor_fr3_joint5" ctrlrange="-12 12"/>
    <motor joint="fr3_joint6" name="motor_fr3_joint6" ctrlrange="-12 12"/>
    <motor joint="fr3_joint7" name="motor_fr3_joint7" ctrlrange="-12 12"/>

    <!-- Gripper: position servo on the driver angle (menagerie). ctrl = target
         driver angle in rad (0 = open, 0.8 = closed); kp = 100, kv = 10.
         forcerange caps the drive force; SimFrankaFR3 rewrites it per command
         to give the commanded squeeze force at the pads. -->
    <general class="robotiq" name="actuator_gripper" tendon="robotiq_split" forcerange="-5 5" ctrlrange="0 0.8"
      gainprm="100 0 0" biasprm="0 -100 -10"/>
  </actuator>
</mujoco>
