                      <!-- Flange (URDF fr3_link8) + Robotiq 2F-85 (URDF fr3_gripper). -->
                      <body name="fr3_gripper" pos="0 0 0.107" quat="1 0 0 0" childclass="robotiq">
                        <!-- Tool centre point between the pad faces (URDF fr3_gripper_tcp), at
                             their height for a ~55 mm opening: the pads ride on an arc and sit
                             8 mm lower fully open, 5 mm higher closed (robotiq_2f85.pad_z). -->
                        <site name="fr3_gripper_tcp" pos="0 0 0.15" size="0.005" rgba="1 0 0 0.5" group="4"/>
                        <!-- Coupling: turned +90 deg so the 2F-85's closing axis (its base y
